{
  "name": "canvas-image-viewer",
  "version": "1.0.0",
  "description": "A pure Canvas-based image viewer library with no framework dependencies",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/canvas-image-viewer.cjs",
  "module": "./dist/canvas-image-viewer.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/canvas-image-viewer.js",
      "require": "./dist/canvas-image-viewer.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "vite build",
    "prepublishOnly": "pnpm build",
    "publish:npm": "npm publish",
    "push:gitee": "git push gitee main",
    "push:github": "git push github main",
    "push:all": "git push gitee main && git push github main"
  },
  "keywords": [
    "canvas",
    "image",
    "viewer",
    "gallery",
    "photo",
    "viewer",
    "image-viewer",
    "canvas-viewer"
  ],
  "author": {
    "name": "mikenchen",
    "email": "chenweizhen@126.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/chenweizhen/canvas-image-viewer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenweizhen/canvas-image-viewer.git"
  },
  "bugs": {
    "url": "https://github.com/chenweizhen/canvas-image-viewer/issues"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vite-plugin-dts": "^5.0.1"
  }
}
