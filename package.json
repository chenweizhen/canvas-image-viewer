{
  "name": "image-viewer-monorepo",
  "private": true,
  "workspaces": [
    "canvas-image-viewer",
    "canvas-image-viewer-vue3",
    "canvas-image-viewer-react"
  ],
  "scripts": {
    "dev:vue": "pnpm --filter canvas-image-viewer-vue3 dev",
    "dev:react": "pnpm --filter canvas-image-viewer-react dev",
    "build:lib": "pnpm --filter canvas-image-viewer build",
    "build:vue": "pnpm --filter canvas-image-viewer-vue3 build",
    "build:react": "pnpm --filter canvas-image-viewer-react build",
    "build:all": "pnpm run build:lib && pnpm run build:vue && pnpm run build:react",
    "release": "powershell -ExecutionPolicy Bypass -File deploy.ps1"
  }
}
